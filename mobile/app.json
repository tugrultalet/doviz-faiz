{
  "expo": {
    "name": "Finans",
    "slug": "finans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finans",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tugrultalet.finans",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tugrultalet.finans",
      "adaptiveIcon": {
        "backgroundColor": "#0A6E4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A6E4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tugrultalet.finans.widgets",
          "groupIdentifier": "group.com.tugrultalet.finans",
          "widgets": [
            {
              "name": "FxWidget",
              "displayName": "Döviz",
              "description": "Dolar ve euro kuru, son 30 günlük değişim ve öneri.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Sesli yatırım danışmanıyla konuşabilmeniz için Finans mikrofonunuzu kullanır.",
          "cameraPermission": "Finans kamerayı kullanmaz."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "tgrltl",
    "extra": {
      "eas": {
        "projectId": "05f2ef35-e07a-4e02-995b-9ba7d99d467b"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/05f2ef35-e07a-4e02-995b-9ba7d99d467b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
